{
  "name": "opentoon",
  "version": "1.0.45",
  "description": "An open-source 2D animation studio for Windows and Linux, inspired by Toon Boom Harmony.",
  "main": "electron/main.js",
  "desktopName": "opentoon-studio.desktop",
  "scripts": {
    "dev": "electron . --dev",
    "start": "electron .",
    "dist": "electron-builder --win --publish never",
    "dist:linux": "electron-builder --linux --publish never",
    "publish": "electron-builder --win --publish always",
    "check-update": "node tools/check-update.cjs",
    "test:electron": "node tests/electron-smoke.cjs",
    "test": "node tests/update-check.cjs && node tests/browsertest.cjs && node tests/vector.cjs && node tests/visual.cjs && node tests/pen.cjs && node tests/features2.cjs"
  },
  "keywords": [
    "animation",
    "2d",
    "toonboom",
    "opentoon"
  ],
  "author": "OpenToon",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^25.1.8",
    "playwright-core": "^1.60.0"
  },
  "build": {
    "appId": "com.opentoon.studio",
    "productName": "OpenToon Studio",
    "files": [
      "index.html",
      "src/**/*",
      "styles/**/*",
      "electron/**/*",
      "assets/**/*",
      "splash/**/*",
      "pen/**/*",
      "fonts/**/*"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "icon": "assets/icons",
      "executableName": "opentoon-studio",
      "category": "Graphics",
      "synopsis": "2D animation studio inspired by Toon Boom Harmony",
      "artifactName": "OpenToon-Studio-${version}-${arch}.${ext}",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "desktop": {
        "StartupWMClass": "opentoon-studio",
        "Keywords": "animation;2d;cartoon;drawing;timeline;"
      }
    },
    "fileAssociations": [
      {
        "ext": "otoon",
        "name": "OpenToon Project",
        "description": "OpenToon animation project",
        "icon": "assets/otoon-file.ico",
        "mimeType": "application/x-opentoon"
      }
    ],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "helliott20",
        "repo": "opentoon",
        "releaseType": "release"
      }
    ]
  }
}
